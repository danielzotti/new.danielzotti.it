{
  "name": "daniel-zotti-next",
  "version": "2.12.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "serve": "serve out -p 3001",
    "build-and-serve": "npm run build && serve out -p 3001",
    "docker:start:local": "docker-compose --file docker-compose.local.yml up --build nextjs",
    "docker:start:server": "CONFIGURATION=production docker-compose --file docker-compose.server.yml up --build nextjs",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "upgrade-to-latest": "npm i next@latest react@latest react-dom@latest eslint-config-next@latest @types/react@latest @types/react-dom@latest"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/luxon": "^3.3.0",
    "@types/qrcode-svg": "^1.1.1",
    "eslint": "8.38.0",
    "eslint-config-next": "^15.5.4",
    "gray-matter": "^4.0.3",
    "luxon": "^3.3.0",
    "markdown-to-jsx": "^7.2.1",
    "next": "^15.5.4",
    "octokit": "^4.1.2",
    "qrcode-svg": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-syntax-highlighter": "^5.8.0",
    "sass": "^1.61.0",
    "serve": "^14.2.1",
    "sharp": "^0.32.1",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@types/gtag.js": "0.0.12",
    "@types/node": "20.17.23",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.4",
    "http-server": "^14.1.1",
    "next-pwa": "^5.6.0"
  },
  "browser": {
    "fs": false
  }
}
